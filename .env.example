# Application
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (leave blank for SQLite, or use PostgreSQL URL)
DATABASE_URL=

# ML Model
MODEL_PATH=artifacts/signspeak_model.joblib
MODEL_METADATA_PATH=artifacts/model_metadata.json

# Inference Configuration
CONFIDENCE_THRESHOLD=0.75
STABILITY_WINDOW=5
STABILITY_MIN_COUNT=4
SIGN_COOLDOWN_MS=800

# WebSocket
MAX_WEBSOCKET_MESSAGE_BYTES=5242880

# Logging
LOG_LEVEL=INFO

# Frontend API (for development)
VITE_API_URL=http://localhost:8000
